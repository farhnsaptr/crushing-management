# Integrasi Crusing API (mishub)
CRUSSING_API_BASE_URL=https://base_api
CRUSSING_API_CLIENT_ID=your_client_id
CRUSSING_API_CLIENT_SECRET=your_client_secret
CRUSSING_API_TIMEOUT_MS=60000
# Format: 'Cibitung=SC1,Karawang=SC2'
CRUSSING_LOCATION_MAP=Cibitung=SC1,Karawang=SC2
